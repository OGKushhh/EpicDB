# ──────────────────────────────────────────────────────────────────────────
# EpicDB environment variables (Vite — all client-exposed vars use VITE_ prefix)
# Copy this file to `.env` and fill in real values. Vite reads `.env` automatically.
# ────────────────────────────────────────────────────────────────────────────

# Manifest API (your Epic-Unlocker Flask backend on Hugging Face)
# Required for the Manifest Browser page.
VITE_MANIFEST_API_KEY=sc_abc123
VITE_MANIFEST_API_BASE=https://ogkushhh-abdobest.hf.space/api/manifest

# Epic Games GraphQL endpoint, via a CORS proxy.
# Browsers cannot call https://graphql.epicgames.com/ue/graphql directly
# because of CORS + a User-Agent whitelist, so a Cloudflare Worker proxy is used.
# The default below is the public proxy from the previous project — feel free
# to deploy your own and point to it here.
VITE_EPIC_GRAPHQL_ENDPOINT=https://epic-cors-proxy.acidicoala.workers.dev
